{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "ADMIN_EMAIL",
        "AI_CATALOGUE_MODEL",
        "ANTHROPIC_API_KEY",
        "BOOKING_FROM_EMAIL",
        "CRON_SECRET",
        "EMAIL_FROM",
        "GALLERY_NOTIFICATIONS_EMAIL",
        "NEWSLETTER_FROM_EMAIL",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
        "NEXT_PUBLIC_PLAUSIBLE_DOMAIN",
        "NEXT_PUBLIC_PLAUSIBLE_SRC",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "OFFERS_FROM_EMAIL",
        "OFFER_LINK_BASE_URL",
        "PLAUSIBLE_API_KEY",
        "PLAUSIBLE_SITE_ID",
        "PLAUSIBLE_STATS_HOST",
        "RESEND_API_KEY",
        "RESEND_WEBHOOK_SECRET",
        "SANCTIONS_ALERT_EMAIL",
        "SANCTIONS_FROM_EMAIL",
        "SANITY_API_WRITE_TOKEN",
        "SANITY_DATASET",
        "SANITY_PROJECT_ID",
        "SANITY_REVALIDATE_SECRET",
        "OFFER_ACCESS_SECRET",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SYNC_SHARED_SECRET",
        "TURNSTILE_SECRET_KEY"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "build",
        "^build"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "NODE_EXTRA_CA_CERTS",
    "SSL_CERT_FILE"
  ]
}