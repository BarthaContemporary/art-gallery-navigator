# ===========================================================================
# Plausible Community Edition — environment
# Copy to `.env` (same directory as docker-compose.yml) and fill every value.
# Docker Compose auto-loads this file for ${...} interpolation AND injects it
# into the plausible container via `env_file:`.
#
# Var names verified against the official reference stack:
#   https://github.com/plausible/community-edition (v3.0.1) compose.yml
#   https://github.com/plausible/community-edition/wiki/configuration
# ===========================================================================

# --- required ---------------------------------------------------------------

# Public URL where Plausible is served (host Caddy terminates TLS here).
BASE_URL=https://analytics.<domain>

# App secret — MUST be at least 64 bytes. Generate with:
#   openssl rand -base64 48
SECRET_KEY_BASE=

# Encryption key for TOTP (2FA) secrets. Generate with:
#   openssl rand -base64 32
TOTP_VAULT_KEY=

# --- registration -----------------------------------------------------------

# Keep registration OPEN only for the very first run so you can create the
# single admin user, then set this to true and `docker compose up -d` again.
DISABLE_REGISTRATION=true

# We create the admin manually; no need to email-verify it. Leave false.
ENABLE_EMAIL_VERIFICATION=false

# --- web --------------------------------------------------------------------

# Internal container port; the compose file publishes it on 127.0.0.1:8000.
HTTP_PORT=8000
HTTPS_PORT=443

# --- databases (internal to the compose network — do NOT expose) ------------

# PostgreSQL. PASSWORD must match POSTGRES_PASSWORD below.
DATABASE_URL=postgres://postgres:PASSWORD@plausible_db:5432/plausible_db

# Password for the plausible_db Postgres container (must equal the password
# embedded in DATABASE_URL above).
POSTGRES_PASSWORD=PASSWORD

# ClickHouse (event store).
CLICKHOUSE_DATABASE_URL=http://plausible_events_db:8123/plausible_events_db

# --- email (Resend over SMTP) -----------------------------------------------
# Plausible sends transactional email (2FA, invites) via SMTP. We point it at
# Resend. SMTP_USER_PWD is your Resend API key (re_...).
MAILER_ADAPTER=Bamboo.SMTPAdapter
MAILER_EMAIL=analytics@<domain>
MAILER_NAME=Plausible Analytics
SMTP_HOST_ADDR=smtp.resend.com
SMTP_HOST_PORT=587
SMTP_USER_NAME=resend
SMTP_USER_PWD=<RESEND_API_KEY>
# Port 587 is STARTTLS, not implicit TLS, so this stays false.
SMTP_HOST_SSL_ENABLED=false
