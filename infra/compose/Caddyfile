# ===========================================================================
# Caddyfile — TLS termination for the self-hosted Supabase stack.
#
# Caddy runs ON THE HOST (apt install caddy — see scripts/provision.sh), NOT
# in docker-compose. Install this file to /etc/caddy/Caddyfile, replace
# example.com with the real domain, then `sudo systemctl reload caddy`.
# Caddy obtains/renews Let's Encrypt certificates automatically, so DNS
# A records for api.<domain> and studio.<domain> must point at the VPS first.
#
# Everything proxies to loopback ports published by docker-compose:
#   kong   → 127.0.0.1:8000
#   studio → 127.0.0.1:3000
# ===========================================================================

# Shared security headers.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Don't advertise the server.
		-Server
	}
}

# ---------------------------------------------------------------------------
# Supabase API gateway — auth, rest, storage (incl. TUS uploads + imgproxy
# renders) all flow through Kong. CORS is handled by Kong, not here.
# ---------------------------------------------------------------------------
api.example.com {
	import security_headers

	# Large TIFF originals arrive as resumable TUS uploads; Caddy streams
	# request bodies by default, so no body-size tuning is needed here
	# (storage-api enforces STORAGE_FILE_SIZE_LIMIT).
	reverse_proxy 127.0.0.1:8000
}

# ---------------------------------------------------------------------------
# Supabase Studio dashboard — break-glass admin only (BUILD_PLAN §2). Single
# shared login is a self-hosting limitation; day-to-day admin happens in the
# studio app. Keep it behind basic-auth, and optionally an IP allowlist.
# ---------------------------------------------------------------------------
studio.example.com {
	import security_headers

	# Generate the hash with:  caddy hash-password
	# (plaintext lives in compose/.env as STUDIO_PASSWORD for record-keeping;
	# only the bcrypt hash goes here).
	basic_auth {
		admin CHANGE_ME_bcrypt_hash_from_caddy_hash-password
	}

	# Optional hardening: uncomment and list trusted IPs/CIDRs to allowlist.
	# @blocked not remote_ip 203.0.113.10 198.51.100.0/24
	# respond @blocked 403

	reverse_proxy 127.0.0.1:3000
}

# ---------------------------------------------------------------------------
# WebDAV shared drive — the gallery's self-hosted "Dropbox" (BUILD_PLAN: files
# on the VPS, in the backup routine). Caddy terminates TLS; the webdav
# container does per-user bcrypt auth and only listens on 127.0.0.1:8081.
# Access is logged to a file so fail2ban can ban brute-force attempts
# (see infra/README.md §6c → §6d).
#
# DNS: point files.<domain> A record at the VPS before first load.
# ---------------------------------------------------------------------------
files.example.com {
	import security_headers

	# Per-request access log → fail2ban tails this for repeated 401s.
	log {
		output file /var/log/caddy/files-access.log
		format json
	}

	# Bodies are streamed, so large uploads are fine. Cap a single upload to a
	# sane ceiling to blunt a disk-fill attack (raise if you move big files).
	request_body {
		max_size 5GB
	}

	# Ordinary browsers (GET/HEAD + Mozilla UA) get bounced to the public
	# website instead of a basic-auth prompt / raw WebDAV XML. Real WebDAV
	# clients (Finder = WebDAVFS, iOS Files, Cryptomator) never send a
	# Mozilla user agent, so their GETs pass straight through.
	@browser {
		method GET HEAD
		header User-Agent *Mozilla*
	}
	redir @browser https://www.joostvandenbergh.com 302

	reverse_proxy 127.0.0.1:8081
}

# ---------------------------------------------------------------------------
# Plausible Analytics (self-hosted, cookieless) — tracks the PUBLIC WEBSITE
# only; the studio is never tracked. The Plausible app publishes on
# 127.0.0.1:8000 via compose/plausible/docker-compose.yml. Uncomment this
# block once that stack is up (see compose/plausible/README.md), replace
# example.com, and `sudo systemctl reload caddy`.
