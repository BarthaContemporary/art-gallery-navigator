# only; the studio is never tracked. The Plausible app publishes on
# 127.0.0.1:8000 via compose/plausible/docker-compose.yml. Uncomment this
# block once that stack is up (see compose/plausible/README.md), replace
# example.com, and `sudo systemctl reload caddy`.
