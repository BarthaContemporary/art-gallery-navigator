# ===========================================================================
# Caddyfile — TLS termination for the self-hosted Supabase stack.
#
# Caddy runs ON THE HOST (apt install caddy — see scripts/provision.sh), NOT
# in docker-compose. Install this file to /etc/caddy/Caddyfile, replace
# example.com with the real domain, then `sudo systemctl reload caddy`.
# Caddy obtains/renews Let's Encrypt certificates automatically, so DNS
# A records for api.<domain> and studio.<domain> must point at the VPS first.
#
# Everything proxies to loopback ports published by docker-compose:
#   kong       → 127.0.0.1:8000
#   studio     → 127.0.0.1:3000
#   opensearch → 127.0.0.1:9200 (search.<domain>, the last site below)
# ===========================================================================

# Global options.
{
	# TCP only. HTTP/3 (QUIC over UDP) is flaky through consumer and mobile
	# ISPs, CGNAT and hotel/venue networks: long request bodies stall mid-air
	# while small requests survive, which presents as "uploads are broken for
	# one person on one connection" and is close to undiagnosable from logs.
	# h1 + h2 over TCP work everywhere. Remove this block only with evidence
	# that h3 helps a workload we actually have.
	servers {
		protocols h1 h2
	}
}

# Shared security headers.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Don't advertise the server.
		-Server
	}
}

# The way in to the Supabase API gateway (Kong). EVERY site that proxies to
# 127.0.0.1:8000 imports this and proxies nowhere else: GoTrue counts nothing
# for a request that arrives without X-JVB-Client-IP, so a second API address
# (for example api.joostvandenbergh.com at go-live) written with its own
# reverse_proxy line would quietly switch the sign-in limits off and reopen
# the code emails. apps/studio/src/app/login/auth-server-config.test.ts
# fails if this file proxies to the gateway any other way, or if this snippet
# changes shape; docs/ops/security-runbook.md shows it as Appendix B and
# step 4 checks the live server.
(supabase_api) {
	# Sign-in paths only in their plain form. Caddy's matchers below read a
	# cleaned, decoded copy of the path, while the gateway routes on the path
	# exactly as sent; a path with percent-encoding, doubled slashes or "."
	# and ".." segments could look like one endpoint to Caddy and another to
	# the gateway, and slip past the closed or the uncounted routes. The apps
	# never send such paths, so they are refused before anything else.
	@auth_noncanonical expression `{http.request.orig_uri}.matches("(?i)^/auth/v1[^?]*([%]|//|/[.][.]?(/|[?]|$))")`
	handle @auth_noncanonical {
		respond "Bad request" 400
	}

	# GoTrue's endpoints that email a sign-in or recovery code to any address
	# the caller names. Nothing the gallery runs uses them from outside:
	# staff are created and re-invited from the studio's Admin page with the
	# service role, which mints the link without these endpoints. From the
	# internet they would only hand an attacker a fresh code to guess at
	# /auth/v1/verify (security review F1). Closed here, not in Kong, so the
	# break-glass dashboard, which talks to Kong inside Docker, keeps them.
	# Path matching is case-insensitive and merges doubled slashes, so
	# variants of these paths are closed too.
	@auth_code_email path /auth/v1/recover* /auth/v1/otp* /auth/v1/magiclink* /auth/v1/resend* /auth/v1/signup*
	handle @auth_code_email {
		respond "Not available" 403
	}

	# Session renewals: GoTrue counts them in the same per-address count as
	# password sign-ins, before it looks at the token. The studio and capture
	# servers renew everyone's session from a few shared Vercel addresses,
	# and anyone can make them try a renewal (any page request with a made-up
	# expired session cookie), so counting renewals would let an outsider use
	# up Vercel's count, sign staff out and refuse their password sign-ins.
	# Renewals therefore reach GoTrue without the address and are not
	# counted. Counting them protected nothing: a renewal needs a refresh
	# token GoTrue made at random, and there are far too many to guess.
	# The matcher must read the grant as GoTrue's Token handler does (Go's
	# r.FormValue, where a form-encoded or multipart body would be read
	# before the URL), so it matches only grant_type=refresh_token in the URL
	# with a JSON body sent under a single Content-Type header, as the
	# Supabase client sends it. Anything else, a password sign-in dressed up
	# as a renewal included, takes the counted route below.
	# The path is compared exactly as sent (after the plain-form check above),
	# not through Caddy's cleaned copy.
	@refresh_grant {
		expression `{http.request.orig_uri.path} == "/auth/v1/token" && {query.grant_type} == "refresh_token" && {header.Content-Type}.matches("^application/json(;[^,]*)?$")`
	}
	handle @refresh_grant {
		reverse_proxy 127.0.0.1:8000 {
			# Dropped, so that the client cannot set it either.
			header_up -X-JVB-Client-IP
		}
	}

	# Everything else. Large TIFF originals arrive as resumable TUS uploads;
	# Caddy streams request bodies by default, so no body-size tuning is
	# needed here (storage-api enforces STORAGE_FILE_SIZE_LIMIT).
	handle {
		reverse_proxy 127.0.0.1:8000 {
			# The address GoTrue counts sign-in and code attempts against
			# (GOTRUE_RATE_LIMIT_HEADER in docker-compose.yml). Set here on
			# every request, replacing anything the client sent, so a client
			# cannot choose its own count. It is the address that connected to
			# Caddy: the studio and capture servers sign in from Vercel, so
			# their requests count against Vercel's addresses. Counting per
			# address relies on this server having no IPv6, as one IPv6 client
			# holds millions of addresses (bootstrap creates the server with
			# IPv6 off; docs/ops/security-runbook.md step 4 checks).
			header_up X-JVB-Client-IP {remote_host}
		}
	}
}

# ---------------------------------------------------------------------------
# Supabase API gateway — auth, rest, storage (incl. TUS uploads + imgproxy
# renders) all flow through Kong. CORS is handled by Kong, not here.
# A further API address gets its own block with these same two imports.
# ---------------------------------------------------------------------------
api.example.com {
	import security_headers
	import supabase_api
}

# ---------------------------------------------------------------------------
# Supabase Studio dashboard — break-glass admin only (BUILD_PLAN §2). Single
# shared login is a self-hosting limitation; day-to-day admin happens in the
# studio app. Keep it behind basic-auth, and optionally an IP allowlist.
# ---------------------------------------------------------------------------
studio.example.com {
	import security_headers

	# This is the break-glass DB dashboard (arbitrary SQL). It is the most
	# powerful endpoint on the box — STRONGLY prefer restricting it to trusted
	# IPs; uncomment and list your VPN/office CIDRs. Leaving it open to the
	# whole internet behind one shared password is discouraged.
	@blocked not remote_ip 203.0.113.10 198.51.100.0/24
	respond @blocked 403

	# Generate the hash with:  caddy hash-password
	# (store the plaintext ONLY in the password manager, never in .env).
	basic_auth {
		admin CHANGE_ME_bcrypt_hash_from_caddy_hash-password
	}

	# Log 401s so fail2ban can ban brute-force attempts against the dashboard
	# (jail: caddy-studio, tails this file). Without this, failed logins against
	# the most sensitive endpoint are invisible to fail2ban.
	log {
		output file /var/log/caddy/studio-access.log
		format json
	}

	reverse_proxy 127.0.0.1:3000
}

# ---------------------------------------------------------------------------
# Shared company calendar (CalDAV / Radicale). Apple Calendar handles
# /.well-known/caldav itself via Radicale's redirect; just proxy everything.
# ---------------------------------------------------------------------------
cal.example.com {
	import security_headers
	reverse_proxy 127.0.0.1:5232
}

# ---------------------------------------------------------------------------
# WebDAV shared drive — the gallery's self-hosted "Dropbox" (BUILD_PLAN: files
# on the VPS, in the backup routine). Caddy terminates TLS; the webdav
# container does per-user bcrypt auth and only listens on 127.0.0.1:8081.
# Access is logged to a file so fail2ban can ban brute-force attempts
# (see infra/README.md §6c → §6d).
#
# DNS: point files.<domain> A record at the VPS before first load.
# ---------------------------------------------------------------------------
files.example.com {
	import security_headers

	# Per-request access log → fail2ban tails this for repeated 401s.
	log {
		output file /var/log/caddy/files-access.log
		format json
	}

	# Bodies are streamed, so large uploads are fine. Cap a single upload to a
	# sane ceiling to blunt a disk-fill attack (raise if you move big files).
	request_body {
		max_size 5GB
	}

	# Ordinary browsers (GET/HEAD + Mozilla UA) get bounced to the public
	# website instead of a basic-auth prompt / raw WebDAV XML. Real WebDAV
	# clients (Finder = WebDAVFS, iOS Files, Cryptomator) never send a
	# Mozilla user agent, so their GETs pass straight through.
	@browser {
		method GET HEAD
		header User-Agent *Mozilla*
	}
	redir @browser https://www.joostvandenbergh.com 302

	reverse_proxy 127.0.0.1:8081
}

