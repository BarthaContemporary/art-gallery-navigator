# ===========================================================================
# jvb-supabase — environment for infra/compose/docker-compose.yml
#
#   cp .env.example .env     # on the VPS, then fill in every CHANGE_ME
#
# .env lives ONLY on the server (mode 0600, owned by deploy). Never commit it.
# Every ${VAR} referenced in docker-compose.yml is defined here.
# ===========================================================================

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Superuser password; also applied to the internal supabase roles on first
# boot (volumes/db/roles.sql). Generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=postgres

# ---------------------------------------------------------------------------
# JWT / API keys
# ---------------------------------------------------------------------------
# MUST be 40+ characters. Everything (GoTrue, PostgREST, storage, the keys
# below) is signed/verified with this. Generate: openssl rand -base64 48
# Changing it later invalidates ANON_KEY/SERVICE_ROLE_KEY and all sessions.
JWT_SECRET=CHANGE_ME_at_least_40_characters_long_secret_value

# Access-token lifetime in seconds.
JWT_EXPIRY=3600

# JWTs with role "anon" / "service_role", signed with JWT_SECRET above.
# Generate with the Supabase CLI (`supabase gen keys` on recent versions) or
# the self-hosting JWT generator: https://supabase.com/docs/guides/self-hosting#api-keys
# SERVICE_ROLE_KEY bypasses RLS — server-side only, never ships to a browser.
ANON_KEY=CHANGE_ME_anon_jwt
SERVICE_ROLE_KEY=CHANGE_ME_service_role_jwt

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# Where auth emails send users back to — the studio app on Vercel.
SITE_URL=https://studio.example.com
# Public URL of this API gateway (Caddy → kong). Used in auth email links.
API_EXTERNAL_URL=https://api.example.com
# Extra comma-separated redirect URLs GoTrue may send users to
# (e.g. Vercel preview deployments).
ADDITIONAL_REDIRECT_URLS=https://*-yourteam.vercel.app
# Keep signups closed — studio users are invite-only (BUILD_PLAN §6).
DISABLE_SIGNUP=true

# ---------------------------------------------------------------------------
# SMTP — Resend (https://resend.com/docs/send-with-smtp)
# ---------------------------------------------------------------------------
# Port 465 = implicit TLS. User is literally "resend"; password is a Resend
# API key (re_...). The sender domain must be verified in Resend first.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_CHANGE_ME_resend_api_key
SMTP_ADMIN_EMAIL=auth@example.com
SMTP_SENDER_NAME=Gallery Studio

# ---------------------------------------------------------------------------
# Storage — S3 backend on Vultr Object Storage (London)
# ---------------------------------------------------------------------------
# From Vultr dashboard → Object Storage. Endpoint has no bucket component.
VULTR_S3_ENDPOINT=https://lhr1.vultrobjects.com
VULTR_S3_REGION=lhr1
# One bucket holds all storage-api objects (piece-originals /
# piece-derivatives / piece-documents are logical buckets inside it).
VULTR_S3_BUCKET=jvb-storage
VULTR_S3_ACCESS_KEY=CHANGE_ME_vultr_access_key
VULTR_S3_SECRET_KEY=CHANGE_ME_vultr_secret_key

# Max upload size accepted by storage-api, in bytes (200 MiB — large TIFF
# originals arrive via resumable TUS uploads).
STORAGE_FILE_SIZE_LIMIT=209715200

# ---------------------------------------------------------------------------
# imgproxy
# ---------------------------------------------------------------------------
# LEAVE BOTH EMPTY for the storage-api integration: storage calls imgproxy
# unsigned over the internal docker network, and imgproxy rejects unsigned
# URLs the moment a key/salt is set. Only fill these (hex, e.g.
# `openssl rand -hex 32` for each) if you ever expose imgproxy directly.
IMGPROXY_KEY=
IMGPROXY_SALT=

# ---------------------------------------------------------------------------
# Studio (break-glass dashboard, studio.example.com)
# ---------------------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=Bartha Contemporary
STUDIO_DEFAULT_PROJECT=jvb
# Basic-auth in front of the dashboard is enforced by Caddy on the HOST, not
# by compose. These two are documented here so all credentials live in one
# place: hash the password with `caddy hash-password` and paste user + hash
# into the Caddyfile's basic_auth block.
STUDIO_USERNAME=admin
STUDIO_PASSWORD=CHANGE_ME_then_hash_into_Caddyfile

# ---------------------------------------------------------------------------
# image-worker
# ---------------------------------------------------------------------------
# Fallback poll interval (ms) — LISTEN/NOTIFY is the fast path.
WORKER_POLL_INTERVAL_MS=60000
# Pending rows claimed per cycle.
WORKER_BATCH_SIZE=5
