# JVB weekly storage-bucket replica (rclone sync of the object-storage bucket
# to its replica bucket). Driven by jvb-backup-storage.timer. Optional — enable
# only after a manual `backup.sh storage-sync` test confirms the replica bucket
# and rclone remote are configured.
[Unit]
Description=JVB weekly object-storage replica
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/opt/jvb/infra/scripts/backup.sh storage-sync
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
