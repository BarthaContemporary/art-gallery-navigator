{
  "name": "jvb-project",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "ui:guard": "node scripts/ui-guard/form-keys.mjs --check",
    "ui:guard:update": "node scripts/ui-guard/form-keys.mjs --update",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "test:unit": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "test:db": "scripts/db-harness/run.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@module-federation/dts-plugin>undici": "^7.30.1",
      "@oclif/core>minimatch": "^11.0.5",
      "@vercel/frameworks>js-yaml": "^3.15.2",
      "@vercel/frameworks>smol-toml": "^1.9.1",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "dompurify@>=3.0.0 <3.4.17": "^3.4.17",
      "exceljs>uuid": "^11.1.1",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "next>postcss": "^8.5.32",
      "react-email>glob": "^14.0.2",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "tar@>=7.0.0 <7.5.21": "^7.5.21"
    }
  }
}
