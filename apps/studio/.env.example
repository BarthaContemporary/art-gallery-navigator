# Supabase (self-hosted on the VPS; local dev: supabase start)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (offers, newsletters, invites)
RESEND_API_KEY=re_xxx
EMAIL_FROM="JVB Gallery <gallery@example.com>"

# Sanity sync (studio pushes web-visible works)
SANITY_PROJECT_ID=xxxx
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=sk_xxx
SYNC_SHARED_SECRET=change-me
