# Supabase (self-hosted on the VPS; local dev: supabase start)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (offers, newsletters, invites)
RESEND_API_KEY=re_xxx
EMAIL_FROM="JVB Gallery <gallery@example.com>"

# Sanity sync (studio pushes web-visible works)
SANITY_PROJECT_ID=xxxx
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=sk_xxx
SYNC_SHARED_SECRET=change-me

# Vercel cron auth
CRON_SECRET=change-me-too

# Plausible Analytics (self-hosted, cookieless). Leave unset locally to disable
# tracking. NEXT_PUBLIC_PLAUSIBLE_DOMAIN must match the site's data-domain in
# the Plausible dashboard; NEXT_PUBLIC_PLAUSIBLE_SRC is this instance's tracker.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=studio.example.com
NEXT_PUBLIC_PLAUSIBLE_SRC=https://analytics.joostvandenbergh.com/js/script.js
# Optional — target of the Settings → Analytics link (defaults to the src origin).
NEXT_PUBLIC_PLAUSIBLE_DASHBOARD=https://analytics.joostvandenbergh.com
