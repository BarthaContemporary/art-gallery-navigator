# Supabase (self-hosted on the VPS; local dev: supabase start)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (offers, newsletters, invites)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Joost van den Bergh <noreply@web.joostvandenbergh.com>"

# Sanity sync (studio pushes web-visible works)
SANITY_PROJECT_ID=xxxx
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=sk_xxx
SYNC_SHARED_SECRET=change-me

# Vercel cron auth
CRON_SECRET=change-me-too

# Optional: the secret that keys the hashes in rate-limit keys (IP addresses,
# emails). Unset, it is derived from SUPABASE_SERVICE_ROLE_KEY; set the same
# value on the studio, website and capture projects if you set it at all.
# RATE_LIMIT_HASH_SECRET=

# Anthropic — AI cataloguing (image analyser → tags/fields). Uses a SEPARATE
# Claude account/key. Default model is claude-sonnet-5 (best value for nuanced,
# always-reviewed vision cataloguing; high-resolution vision reads signatures /
# tomobako inscriptions). Override with AI_CATALOGUE_MODEL: claude-haiku-4-5 to
# cut cost further, or claude-opus-4-8 for maximum quality. Leave the key unset
# to disable the analyser (it degrades gracefully).
ANTHROPIC_API_KEY=sk-ant-xxx
# AI_CATALOGUE_MODEL=claude-sonnet-5
# Maker biography drafts research the maker with web search and need the
# strongest writing model — default claude-opus-4-8. Override only to trade
# quality for cost.
# AI_BIOGRAPHY_MODEL=claude-opus-4-8

# Shared drive (WebDAV) — documents produced by the export routes are also
# copied to Downloads/{Certificates|Presentations|Docs} on the gallery drive.
# Not the stock book: financial exports are downloads only, since every staff
# drive account can read the whole tree (security review F14).
# Uses a dedicated `studio` WebDAV account (infra/compose/webdav/webdav.yml).
# Leave unset to disable the copies (downloads still work).
SHARED_DRIVE_URL=https://drive.joostvandenbergh.com
SHARED_DRIVE_USER=studio
SHARED_DRIVE_PASSWORD=xxx

# Shared company calendar (CalDAV / Radicale, infra/README.md §6h) — the
# appointments page renders a month view of the gallery calendar next to the
# studio's own appointments. Server-side only (never NEXT_PUBLIC — the
# credentials must not reach the browser). Uses the same shared `gallery`
# account the Apple devices use. Leave unset to hide the calendar events
# (appointments still show on the grid).
CALDAV_URL=https://cal.joostvandenbergh.com
CALDAV_USER=gallery
CALDAV_PASSWORD=xxx

# Plausible Analytics — READ-ONLY. Tracking runs on the PUBLIC WEBSITE only;
# the studio is never tracked. These let the studio's /analytics page read the
# public site's visitor results via the Plausible Stats API. Server-side only
# (never NEXT_PUBLIC — the API key must not reach the browser). Leave unset to
# hide the results until Plausible is running.
PLAUSIBLE_STATS_HOST=https://analytics.joostvandenbergh.com
PLAUSIBLE_API_KEY=change-me
PLAUSIBLE_SITE_ID=joostvandenbergh.com

# Cloudflare Turnstile — bot protection on the studio login form. Site key is
# public (widget); secret key is server-only (token verification). Leave BOTH
# unset to disable the challenge. When the secret is set, a valid token is
# required to sign in.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
