# Capture app (capture.joostvandenbergh.com) — the variables it reads.
# Set them in the Vercel "capture" project (Production and Preview).

# Supabase (the self-hosted API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The app's own address, and the passkey relying-party id (the domain the
# passkeys are bound to). Leave the RP id unset to use the app's host name.
NEXT_PUBLIC_APP_ORIGIN=https://capture.joostvandenbergh.com
# NEXT_PUBLIC_PASSKEY_RP_ID=capture.joostvandenbergh.com

# Cloudflare Turnstile on the sign-in form. While the secret is unset the
# check is skipped (local development); set both in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI cataloguing (card scan, work detection, invoice reading). Unset disables
# them gracefully. Each person is limited per hour (src/lib/ai-limit.ts).
ANTHROPIC_API_KEY=sk-ant-xxx
# AI_CATALOGUE_MODEL=claude-sonnet-5

# Google Maps: the browser key (restricted by referrer to this app's address)
# draws the map; the server key (restricted by API, no referrer) geocodes
# addresses from the server. docs/ops/security-runbook.md step 8.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Optional: see apps/studio/.env.example.
# RATE_LIMIT_HASH_SECRET=
