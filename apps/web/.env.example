# ------------------------------------------------------------------
# @jvb/web — environment variables
# Copy to .env.local for development. All server-only secrets stay
# out of NEXT_PUBLIC_*.
# ------------------------------------------------------------------

# Canonical site origin (no trailing slash). Used for metadata,
# sitemap/robots, JSON-LD and llms.txt URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Sanity (editorial content + synced work docs) -----------------
# Project id and dataset from sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret configured on the Sanity webhook that POSTs to
# /api/revalidate (signature-verified by next-sanity).
SANITY_REVALIDATE_SECRET=

# --- Supabase (offers, booking, enquiries, unsubscribe) -------------
# Self-hosted Supabase API origin (Kong), e.g. https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=
# Anon key — required by @jvb/db's browser/server clients; this app
# only uses the service client at runtime but the package reads both.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Powers /o/[token], /api/booking,
# /o/[token]/respond, /api/unsubscribe (bypasses RLS; never expose).
SUPABASE_SERVICE_ROLE_KEY=

# Signs the access cookie and emailed sign-in links of password-protected
# private offers. Optional: when unset the site signs with
# SANITY_REVALIDATE_SECRET (or SYNC_SHARED_SECRET) instead, as it always has.
# With none of the three set, gated offers cannot be unlocked at all.
# Setting it later signs everyone out of gated offers once.
OFFER_ACCESS_SECRET=

# --- Resend (booking confirmation emails + staff notifications) ----
RESEND_API_KEY=
# Verified sender for all website emails: a bare address (bookings@example.com)
# or one with its name ("Gallery <bookings@example.com>"); both work.
BOOKING_FROM_EMAIL=
# Where staff notifications go (falls back to siteSettings.email in Sanity).
GALLERY_NOTIFICATIONS_EMAIL=

# --- Plausible Analytics (self-hosted, cookieless) -----------------
# Public-site visitor tracking. Leave unset to disable. DOMAIN must match the
# site added in Plausible (its data-domain); SRC is this instance's tracker.
# The site loads the manual tracker beside it (script.manual.js) and sends
# each page view itself, so private offer and confirmation pages are never
# recorded; a SRC that is not a Plausible script.js / plausible.js file name
# switches Plausible off rather than load a tracker that would record them.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=joostvandenbergh.com
NEXT_PUBLIC_PLAUSIBLE_SRC=https://analytics.joostvandenbergh.com/js/script.js

# --- Resend event webhook (newsletter/offer open+click+bounce tracking) ---
# If set, POSTs to /api/resend-webhook must carry ?secret=<this value>.
RESEND_WEBHOOK_SECRET=

# --- Cloudflare Turnstile (bot protection on the booking, enquiry,
#     newsletter and offer forms) ---
# Both keys come from the Turnstile widget in the Cloudflare dashboard.
# Leave BOTH unset to disable the challenge (forms stay open). When the
# secret is set, a valid token is required server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: the secret that keys the hashes in rate-limit keys (IP addresses,
# emails). Unset, it is derived from SUPABASE_SERVICE_ROLE_KEY; set the same
# value on the studio, website and capture projects if you set it at all.
# RATE_LIMIT_HASH_SECRET=
