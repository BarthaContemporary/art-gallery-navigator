# ------------------------------------------------------------------
# @jvb/web — environment variables
# Copy to .env.local for development. All server-only secrets stay
# out of NEXT_PUBLIC_*.
# ------------------------------------------------------------------

# Canonical site origin (no trailing slash). Used for metadata,
# sitemap/robots, JSON-LD and llms.txt URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Sanity (editorial content + synced work docs) -----------------
# Project id and dataset from sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret configured on the Sanity webhook that POSTs to
# /api/revalidate (signature-verified by next-sanity).
SANITY_REVALIDATE_SECRET=

# --- Supabase (offers, booking, enquiries, unsubscribe) -------------
# Self-hosted Supabase API origin (Kong), e.g. https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=
# Anon key — required by @jvb/db's browser/server clients; this app
# only uses the service client at runtime but the package reads both.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Powers /o/[token], /api/booking,
# /api/offer-response, /api/unsubscribe (bypasses RLS; never expose).
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (booking confirmation emails + staff notifications) ----
RESEND_API_KEY=
# Verified sender for booking emails, e.g. "Gallery <bookings@example.com>"
BOOKING_FROM_EMAIL=
# Where staff notifications go (falls back to siteSettings.email in Sanity).
GALLERY_NOTIFICATIONS_EMAIL=
