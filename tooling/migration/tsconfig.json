{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    // Local imports name the .ts file, so `node --test` (which strips types
    // but does not map .js to .ts) can load the modules the tests cover; tsx
    // runs them the same way.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
